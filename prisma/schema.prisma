// Florida Roleplay Manager - database schema
//
// Conventions:
//  * Internal identifiers are UUIDs. Discord identifiers are snowflakes stored as
//    strings, because they exceed Number.MAX_SAFE_INTEGER.
//  * Records that carry history are soft deleted with `deletedAt`. Natural-key
//    uniqueness is preserved by *restoring* a soft-deleted row when the same natural
//    key is created again, rather than by inserting a duplicate.
//  * AuditLog is append-only: no soft delete column, and no service writes an update.
//  * Nullable foreign keys use Restrict so that a referenced record can never be hard
//    deleted out from under an audit trail.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums (mirrored in packages/shared/src/enums.js - see tests/unit/enum-parity)
// ---------------------------------------------------------------------------

enum GuildType {
  MAIN_COMMUNITY
  DEPARTMENT
  SUBDIVISION
  STAFF
  OTHER
}

enum UserStatus {
  ACTIVE
  DISABLED
  BANNED
}

enum MappingDirection {
  ONE_WAY
  TWO_WAY
}

enum AuthoritySource {
  SOURCE_DISCORD
  TARGET_DISCORD
  MANUAL
  SYSTEM
}

enum RolePurpose {
  MAPPING
  MANUAL_GRANT
  OTHER
}

enum ProtectionLevel {
  NONE
  ELEVATED
  TWO_PERSON
}

enum PermissionScopeType {
  GLOBAL
  GUILD
}

enum SyncJobType {
  MEMBER_RESYNC
  GUILD_RESYNC
  GLOBAL_RESYNC
  ROLE_ADD
  ROLE_REMOVE
  MAPPING_PROPAGATION
  GRANT_CHANGE
  SCHEDULED_RECONCILIATION
  MAPPING_VALIDATION
  ROSTER_MEMBER_SYNC
  ROSTER_SYNC
}

enum SyncJobStatus {
  PENDING
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

enum SyncActionType {
  ADD_ROLE
  REMOVE_ROLE
}

enum SyncActionStatus {
  PENDING
  APPLIED
  SKIPPED
  FAILED
  DRY_RUN
}

enum SyncIssueType {
  MEMBER_NOT_IN_GUILD
  MEMBER_NOT_LINKED
  BOT_MISSING_PERMISSION
  BOT_NOT_IN_GUILD
  ROLE_ABOVE_BOT
  ROLE_DELETED
  INVALID_ROLE_REFERENCE
  INTEGRATION_MANAGED_ROLE
  PROTECTED_ROLE_VIOLATION
  GUILD_UNAVAILABLE
  GUILD_NOT_APPROVED
  RATE_LIMITED
  API_TIMEOUT
  DISCORD_ERROR
  DATABASE_ERROR
  REDIS_ERROR
  MAPPING_CONFLICT
  THRESHOLD_EXCEEDED
  ENQUEUE_FAILED
  MEMBER_ABOVE_BOT
  UNKNOWN
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum ActionSource {
  DISCORD
  WEBSITE
  SYSTEM
  SCHEDULED
}

enum PendingApprovalType {
  MAPPING_ACTIVATION
  PROTECTED_ROLE_MAPPING
  GUILD_REGISTRATION
  GUILD_REMOVAL
  GLOBAL_RESYNC
}

/// Whether somebody currently appears on a roster. Departures are kept rather than
/// deleted: "who was Senior Admin last March" is a question that gets asked.
enum RosterMembershipStatus {
  ACTIVE
  DEPARTED
}

enum PendingApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// A community member. One row per person, never one row per guild membership.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  displayName      String
  email            String?    @unique
  status           UserStatus @default(ACTIVE)
  /// Authority tier. A user may never act on someone at or above their own level.
  permissionLevel  Int        @default(0)
  /// Whether the account may sign in to the department hub website.
  websiteAccess    Boolean    @default(false)
  /// True when `websiteAccess` was granted by a Discord access tier rather than by hand.
  /// Only tier-granted access is taken back when the role goes away, so an explicit grant
  /// is never silently revoked by a sweep.
  accessFromTier   Boolean    @default(false)
  /// Denormalized copy of the primary DiscordIdentity for fast lookups.
  primaryDiscordId String?    @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  discordIdentities   DiscordIdentity[]      @relation("IdentityOwner")
  linkedIdentities    DiscordIdentity[]      @relation("IdentityLinker")
  permissions         PermissionAssignment[] @relation("PermissionHolder")
  grantedPermissions  PermissionAssignment[] @relation("PermissionGranter")
  revokedPermissions  PermissionAssignment[] @relation("PermissionRevoker")
  manualGrants        ManualRoleGrant[]      @relation("ManualGrantHolder")
  issuedManualGrants  ManualRoleGrant[]      @relation("ManualGrantIssuer")
  revokedManualGrants ManualRoleGrant[]      @relation("ManualGrantRevoker")
  registeredGuilds    ApprovedGuild[]        @relation("GuildRegistrar")
  removedGuilds       ApprovedGuild[]        @relation("GuildRemover")
  createdMappings     RoleMapping[]          @relation("MappingCreator")
  initiatedJobs       SyncJob[]              @relation("JobInitiator")
  syncActions         SyncAction[]           @relation("SyncActionSubject")
  syncIssues          SyncIssue[]            @relation("IssueSubject")
  resolvedIssues      SyncIssue[]            @relation("IssueResolver")
  auditActions        AuditLog[]             @relation("AuditActor")
  auditTargets        AuditLog[]             @relation("AuditTarget")
  requestedApprovals  PendingApproval[]      @relation("ApprovalRequester")
  resolvedApprovals   PendingApproval[]      @relation("ApprovalResolver")
  approvalVotes       PendingApprovalVote[]
  systemSettings      SystemSetting[]        @relation("SettingUpdater")
  createdGrantRules   RoleGrantRule[]        @relation("RoleGrantRuleCreator")
  createdAccessTiers  RoleAccessTier[]       @relation("AccessTierCreator")
  createdRosters      Roster[]               @relation("RosterCreator")
  rosterMemberships   RosterMembership[]     @relation("RosterMember")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

/// A Discord account linked to a platform user. The Discord user ID is the primary
/// external identity of a community member.
model DiscordIdentity {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  discordUserId String    @unique
  username      String?
  globalName    String?
  avatarHash    String?
  isPrimary     Boolean   @default(true)
  linkedAt      DateTime  @default(now())
  verifiedAt    DateTime?
  linkedById    String?   @db.Uuid

  user     User  @relation("IdentityOwner", fields: [userId], references: [id], onDelete: Cascade)
  linkedBy User? @relation("IdentityLinker", fields: [linkedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("discord_identities")
}

// ---------------------------------------------------------------------------
// Guild allowlist
// ---------------------------------------------------------------------------

/// The allowlist. A guild that is not present here (and enabled) cannot be used for
/// anything: no commands, no mappings, no role writes.
model ApprovedGuild {
  id             String    @id @default(uuid()) @db.Uuid
  discordGuildId String    @unique
  name           String
  type           GuildType
  enabled        Boolean   @default(true)
  syncEnabled    Boolean   @default(true)
  /// Named feature flags, e.g. ["mappings", "manual-grants"].
  features       String[]  @default([])
  notes          String?
  registeredAt   DateTime  @default(now())
  registeredById String?   @db.Uuid
  removedAt      DateTime?
  removedById    String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  registeredBy User? @relation("GuildRegistrar", fields: [registeredById], references: [id], onDelete: Restrict)
  removedBy    User? @relation("GuildRemover", fields: [removedById], references: [id], onDelete: Restrict)

  managedRoles   ManagedRole[]
  sourceMappings RoleMapping[]   @relation("MappingSourceGuild")
  targetMappings RoleMapping[]   @relation("MappingTargetGuild")
  roleGrantRules RoleGrantRule[]
  syncJobs       SyncJob[]
  syncActions    SyncAction[]
  syncIssues     SyncIssue[]
  auditLogs      AuditLog[]
  rosters        Roster[]

  @@index([enabled])
  @@index([type])
  @@index([deletedAt])
  @@map("approved_guilds")
}

// ---------------------------------------------------------------------------
// Managed roles and mappings
// ---------------------------------------------------------------------------

/// A Discord role the platform is allowed to control. The reconciliation engine may
/// only ever remove a role that has a row here: everything else is a member's own
/// business and is never touched.
model ManagedRole {
  id                String          @id @default(uuid()) @db.Uuid
  approvedGuildId   String          @db.Uuid
  discordRoleId     String
  name              String
  purpose           RolePurpose     @default(MAPPING)
  protectionLevel   ProtectionLevel @default(NONE)
  /// False marks a role as "known but hands off" - it participates in conflict
  /// detection but is never added or removed automatically.
  managedByPlatform Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  guild        ApprovedGuild     @relation(fields: [approvedGuildId], references: [id], onDelete: Cascade)
  manualGrants ManualRoleGrant[]
  syncActions  SyncAction[]

  @@unique([approvedGuildId, discordRoleId])
  @@index([purpose])
  @@map("managed_roles")
}

/// Time-bounded manual authority: temporary sensitive access, event assignments,
/// investigation access. These are the desired state for MANUAL-authority roles.
model ManualRoleGrant {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  managedRoleId String    @db.Uuid
  grantedById   String?   @db.Uuid
  reason        String
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedById   String?   @db.Uuid
  createdAt     DateTime  @default(now())

  user        User        @relation("ManualGrantHolder", fields: [userId], references: [id], onDelete: Cascade)
  managedRole ManagedRole @relation(fields: [managedRoleId], references: [id], onDelete: Cascade)
  grantedBy   User?       @relation("ManualGrantIssuer", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy   User?       @relation("ManualGrantRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([managedRoleId])
  @@index([expiresAt])
  @@map("manual_role_grants")
}

model RoleMapping {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  sourceGuildId    String           @db.Uuid
  sourceRoleId     String
  targetGuildId    String           @db.Uuid
  targetRoleId     String
  direction        MappingDirection @default(ONE_WAY)
  authority        AuthoritySource  @default(SOURCE_DISCORD)
  syncAdd          Boolean          @default(true)
  syncRemove       Boolean          @default(true)
  enabled          Boolean          @default(false)
  priority         Int              @default(100)
  /// Set when either side is a protected role: the mapping cannot be enabled until a
  /// second authorized approver signs off.
  requiresApproval Boolean          @default(false)
  approvedAt       DateTime?
  createdById      String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  sourceGuild ApprovedGuild @relation("MappingSourceGuild", fields: [sourceGuildId], references: [id], onDelete: Cascade)
  targetGuild ApprovedGuild @relation("MappingTargetGuild", fields: [targetGuildId], references: [id], onDelete: Cascade)
  createdBy   User?         @relation("MappingCreator", fields: [createdById], references: [id], onDelete: Restrict)

  syncJobs    SyncJob[]
  syncActions SyncAction[]
  syncIssues  SyncIssue[]
  auditLogs   AuditLog[]
  approvals   PendingApproval[]

  @@unique([sourceGuildId, sourceRoleId, targetGuildId, targetRoleId])
  @@index([sourceGuildId, sourceRoleId])
  @@index([targetGuildId, targetRoleId])
  @@index([enabled])
  @@index([deletedAt])
  @@map("role_mappings")
}

/// Self-service role delegation. In a guild, a member holding `grantorRoleId` may hand out
/// (and take back) `grantableRoleId` through `/rolemanager`, without any platform
/// capability. One row per (grantor, grantable) pair; the mapping is edited by an admin.
///
/// These are ordinarily roles the platform does NOT manage (cosmetic, notification, or
/// access roles), so reconciliation never touches them - this feature is the only writer.
model RoleGrantRule {
  id                String    @id @default(uuid()) @db.Uuid
  approvedGuildId   String    @db.Uuid
  /// The Discord role a member must hold to be allowed to hand out the grantable role.
  grantorRoleId     String
  grantorRoleName   String
  /// The Discord role that may be assigned or removed.
  grantableRoleId   String
  grantableRoleName String
  createdById       String?   @db.Uuid
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  guild     ApprovedGuild @relation(fields: [approvedGuildId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("RoleGrantRuleCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([approvedGuildId, grantorRoleId, grantableRoleId])
  @@index([approvedGuildId, grantorRoleId])
  @@index([deletedAt])
  @@map("role_grant_rules")
}

/// Discord-role-driven access. A role in the main community guild is mapped to an authority
/// tier; a member who holds it is treated, at command time, as having that tier and every
/// capability up to it - without an explicit permission grant. This is how a community runs
/// bot access off its existing staff roles instead of provisioning each person by hand.
///
/// The mapping is resolved live from the member's current Discord roles, so losing the role
/// loses the access on the next command. It never persists authority onto the account.
model RoleAccessTier {
  id              String    @id @default(uuid()) @db.Uuid
  /// A role in the main community guild.
  discordRoleId   String    @unique
  roleName        String
  /// The authority tier (0-100) holders are granted; see PermissionLevel.
  permissionLevel Int
  createdById     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  createdBy User? @relation("AccessTierCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([deletedAt])
  @@map("role_access_tiers")
}

// ---------------------------------------------------------------------------
// Rosters
// ---------------------------------------------------------------------------

/// A published staff roster: the staff team, or one department's chain of command.
///
/// A roster belongs to exactly one guild, because that is the guild whose roles decide
/// who is on it and whose nicknames get rewritten. A community with one staff roster and
/// a roster per department models each as its own row; nothing else has to change.
model Roster {
  id                  String    @id @default(uuid()) @db.Uuid
  /// URL-safe identifier the website addresses this roster by. Stable across renames.
  slug                String    @unique
  name                String
  description         String?
  approvedGuildId     String    @db.Uuid
  /// Whether the public API serves this roster. A roster can be configured and
  /// reconciled for a while before anybody outside Discord sees it.
  published           Boolean   @default(true)
  /// Ordering on the website, and the tie-break when a member sits on two rosters in
  /// one guild: the lowest position owns their nickname.
  position            Int       @default(0)
  /// Whether membership of this roster rewrites Discord nicknames.
  nicknameSyncEnabled Boolean   @default(true)
  createdById         String?   @db.Uuid
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  guild       ApprovedGuild      @relation(fields: [approvedGuildId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("RosterCreator", fields: [createdById], references: [id], onDelete: Restrict)
  ranks       RosterRank[]
  memberships RosterMembership[]

  @@index([approvedGuildId])
  @@index([deletedAt])
  @@map("rosters")
}

/// One rank on a roster, bound to the Discord role that confers it.
///
/// The binding is what makes Discord the source of truth: holding the role *is* being
/// that rank. Nothing grants a rank directly.
model RosterRank {
  id            String    @id @default(uuid()) @db.Uuid
  rosterId      String    @db.Uuid
  /// The role in the roster's guild that confers this rank.
  discordRoleId String
  name          String
  /// The abbreviated form used in nicknames, e.g. "Jr. Admin". Falls back to `name`.
  shortName     String?
  /// Seniority. Highest wins when a member holds several bound roles, and orders the
  /// roster on the website.
  position      Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  roster      Roster             @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  memberships RosterMembership[]

  @@unique([rosterId, discordRoleId])
  @@index([rosterId, position])
  @@map("roster_ranks")
}

/// Somebody's place on a roster.
///
/// Keyed by Discord id rather than platform user, because a staff member appears on the
/// roster whether or not they have ever signed in to the website. `userId` is filled in
/// when an identity exists so the record joins up with the rest of the platform.
model RosterMembership {
  id              String                 @id @default(uuid()) @db.Uuid
  rosterId        String                 @db.Uuid
  discordUserId   String
  userId          String?                @db.Uuid
  rankId          String?                @db.Uuid
  /// In-game callsign shown before the rank, e.g. "165". Set by a human; never derived.
  callsign        String?
  /// An explicit override set by an administrator. Null unless somebody has set one,
  /// which is what makes it authoritative: when it is present the member cannot rename
  /// themselves out of it, and when it is absent their own nickname decides.
  preferredName   String?
  /// The name segment last resolved for this member - from their override, their
  /// nickname, or their username. Derived, never authoritative; the website reads it so
  /// a roster page does not have to re-derive names for everybody on every request.
  displayName     String?
  status          RosterMembershipStatus @default(ACTIVE)
  /// The last nickname the platform wrote, so an externally changed nickname can be
  /// told apart from one that is simply out of date.
  managedNickname String?
  joinedAt        DateTime               @default(now())
  departedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  roster Roster      @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  rank   RosterRank? @relation(fields: [rankId], references: [id], onDelete: SetNull)
  user   User?       @relation("RosterMember", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([rosterId, discordUserId])
  @@index([rosterId, status])
  @@index([discordUserId])
  @@map("roster_memberships")
}

// ---------------------------------------------------------------------------
// Permissions
// ---------------------------------------------------------------------------

/// Catalogue of capabilities, seeded from packages/shared/src/capabilities.js.
model PermissionCapability {
  key         String   @id
  category    String
  description String
  dangerous   Boolean  @default(false)
  minLevel    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments PermissionAssignment[]

  @@map("permission_capabilities")
}

/// A capability granted to a user within a scope, optionally bounded by a maximum
/// manageable permission level.
model PermissionAssignment {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  capabilityKey      String
  scopeType          PermissionScopeType
  /// Empty string for GLOBAL scope so the unique constraint stays enforceable
  /// (Postgres treats NULLs as distinct inside unique indexes).
  scopeId            String              @default("")
  maxPermissionLevel Int?
  grantedById        String?             @db.Uuid
  grantedAt          DateTime            @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedById        String?             @db.Uuid
  reason             String?

  user       User                 @relation("PermissionHolder", fields: [userId], references: [id], onDelete: Cascade)
  capability PermissionCapability @relation(fields: [capabilityKey], references: [key], onDelete: Restrict)
  grantedBy  User?                @relation("PermissionGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy  User?                @relation("PermissionRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@unique([userId, capabilityKey, scopeType, scopeId])
  @@index([userId])
  @@index([capabilityKey])
  @@index([expiresAt])
  @@map("permission_assignments")
}

// ---------------------------------------------------------------------------
// Synchronization
// ---------------------------------------------------------------------------

model SyncJob {
  id                   String        @id @default(uuid()) @db.Uuid
  type                 SyncJobType
  status               SyncJobStatus @default(PENDING)
  source               ActionSource
  initiatedById        String?       @db.Uuid
  initiatedByDiscordId String?
  approvedGuildId      String?       @db.Uuid
  targetUserId         String?       @db.Uuid
  mappingId            String?       @db.Uuid
  dryRun               Boolean       @default(false)
  progressTotal        Int           @default(0)
  progressCompleted    Int           @default(0)
  attempts             Int           @default(0)
  queueJobId           String?
  parentJobId          String?       @db.Uuid
  requestId            String?
  reason               String?
  payload              Json?
  error                Json?
  /// True when the maximum-change threshold paused this job.
  thresholdBreached    Boolean       @default(false)
  createdAt            DateTime      @default(now())
  startedAt            DateTime?
  completedAt          DateTime?

  initiatedBy User?          @relation("JobInitiator", fields: [initiatedById], references: [id], onDelete: Restrict)
  guild       ApprovedGuild? @relation(fields: [approvedGuildId], references: [id], onDelete: Restrict)
  mapping     RoleMapping?   @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  parent      SyncJob?       @relation("JobChildren", fields: [parentJobId], references: [id], onDelete: Cascade)
  children    SyncJob[]      @relation("JobChildren")

  actions   SyncAction[]
  issues    SyncIssue[]
  auditLogs AuditLog[]

  @@index([status, createdAt])
  @@index([type])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("sync_jobs")
}

/// A single planned or executed role change.
model SyncAction {
  id              String           @id @default(uuid()) @db.Uuid
  syncJobId       String           @db.Uuid
  action          SyncActionType
  status          SyncActionStatus @default(PENDING)
  userId          String?          @db.Uuid
  discordUserId   String
  approvedGuildId String?          @db.Uuid
  discordGuildId  String
  discordRoleId   String
  roleName        String?
  managedRoleId   String?          @db.Uuid
  mappingId       String?          @db.Uuid
  /// Human readable explanation, e.g. "mapping: Media Team".
  reason          String
  attempt         Int              @default(0)
  error           String?
  appliedAt       DateTime?
  createdAt       DateTime         @default(now())

  job         SyncJob        @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  user        User?          @relation("SyncActionSubject", fields: [userId], references: [id], onDelete: Restrict)
  guild       ApprovedGuild? @relation(fields: [approvedGuildId], references: [id], onDelete: Restrict)
  managedRole ManagedRole?   @relation(fields: [managedRoleId], references: [id], onDelete: Restrict)
  mapping     RoleMapping?   @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  issues      SyncIssue[]

  @@index([syncJobId])
  @@index([discordUserId])
  @@index([status])
  @@index([createdAt])
  @@map("sync_actions")
}

/// An unresolved synchronization failure. These are what an administrator reviews and
/// retries; a job never silently swallows a failure.
model SyncIssue {
  id              String        @id @default(uuid()) @db.Uuid
  type            SyncIssueType
  severity        IssueSeverity @default(ERROR)
  syncJobId       String?       @db.Uuid
  syncActionId    String?       @db.Uuid
  approvedGuildId String?       @db.Uuid
  discordGuildId  String?
  userId          String?       @db.Uuid
  discordUserId   String?
  mappingId       String?       @db.Uuid
  discordRoleId   String?
  message         String
  details         Json?
  resolved        Boolean       @default(false)
  resolvedAt      DateTime?
  resolvedById    String?       @db.Uuid
  retryCount      Int           @default(0)
  lastRetryAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  job        SyncJob?       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  action     SyncAction?    @relation(fields: [syncActionId], references: [id], onDelete: Cascade)
  guild      ApprovedGuild? @relation(fields: [approvedGuildId], references: [id], onDelete: Restrict)
  user       User?          @relation("IssueSubject", fields: [userId], references: [id], onDelete: Restrict)
  mapping    RoleMapping?   @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  resolvedBy User?          @relation("IssueResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([resolved, createdAt])
  @@index([type])
  @@index([userId])
  @@index([approvedGuildId])
  @@map("sync_issues")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only audit trail. No service method updates or deletes these rows; see
/// docs/security.md for the database-level hardening recommendation.
model AuditLog {
  id              String       @id @default(uuid()) @db.Uuid
  action          String
  source          ActionSource
  actorUserId     String?      @db.Uuid
  actorDiscordId  String?
  targetUserId    String?      @db.Uuid
  targetDiscordId String?
  approvedGuildId String?      @db.Uuid
  mappingId       String?      @db.Uuid
  syncJobId       String?      @db.Uuid
  previousState   Json?
  newState        Json?
  reason          String?
  requestId       String?
  ipAddress       String?
  userAgent       String?
  success         Boolean      @default(true)
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime     @default(now())

  actor   User?          @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target  User?          @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  guild   ApprovedGuild? @relation(fields: [approvedGuildId], references: [id], onDelete: Restrict)
  mapping RoleMapping?   @relation(fields: [mappingId], references: [id], onDelete: Restrict)
  job     SyncJob?       @relation(fields: [syncJobId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
  @@index([approvedGuildId, createdAt])
  @@index([mappingId])
  @@index([syncJobId])
  @@index([requestId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Approvals and settings
// ---------------------------------------------------------------------------

/// Two-person rule. A protected mapping stays inert until a second authorized user
/// approves it.
model PendingApproval {
  id                 String                @id @default(uuid()) @db.Uuid
  type               PendingApprovalType
  status             PendingApprovalStatus @default(PENDING)
  payload            Json
  requiredCapability String
  requiredApprovals  Int                   @default(1)
  mappingId          String?               @db.Uuid
  requestedById      String                @db.Uuid
  requestedAt        DateTime              @default(now())
  expiresAt          DateTime
  resolvedAt         DateTime?
  resolvedById       String?               @db.Uuid
  resolutionReason   String?

  mapping     RoleMapping?          @relation(fields: [mappingId], references: [id], onDelete: Cascade)
  requestedBy User                  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  resolvedBy  User?                 @relation("ApprovalResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  votes       PendingApprovalVote[]

  @@index([status, expiresAt])
  @@index([type])
  @@map("pending_approvals")
}

model PendingApprovalVote {
  id         String   @id @default(uuid()) @db.Uuid
  approvalId String   @db.Uuid
  userId     String   @db.Uuid
  approve    Boolean
  comment    String?
  createdAt  DateTime @default(now())

  approval PendingApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([approvalId, userId])
  @@map("pending_approval_votes")
}

model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("system_settings")
}
