# =============================================================================
# Florida Roleplay Manager - example environment file
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Every variable below is validated at startup by `@frm/shared/env`.
# In production, missing or weak required secrets abort the process (fail closed).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Development mode relaxes guild auto-leave, enables dry-run by default and
# allows the Discord gateway to be mocked. It is FORCED OFF when NODE_ENV=production.
DEV_MODE=true

# Comma separated guild IDs the bot is allowed to operate in while DEV_MODE=true.
DEV_GUILD_IDS=

# When true, no real Discord role writes are performed (development only).
DISCORD_MOCK=false

# When true, sync jobs default to dry-run unless explicitly told otherwise.
SYNC_DRY_RUN_DEFAULT=true

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://frm:frm_local_password@localhost:5432/frm?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Discord application -----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
# This value must never reach the frontend or any log line.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Only required by the API for the OAuth login flow.
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Comma separated Discord user IDs bootstrapped as global system administrators.
# These accounts are seeded with `system.manage` at GLOBAL scope.
GLOBAL_ADMIN_DISCORD_IDS=

# Optional webhook used to alert global administrators (unapproved guild joins,
# paused jobs, threshold breaches). Treated as a secret and redacted from logs.
ADMIN_ALERT_WEBHOOK_URL=

# Optional Discord channel webhook the `/mike` command posts to-do items to.
# Treated as a secret (its token grants posting). The command is inert until set.
MIKE_TODO_WEBHOOK_URL=

# Optional comma-separated role ids allowed to run `/mike` (Community Director and up).
# Leave empty to use the command's built-in ownership + director role list.
MIKE_ALLOWED_ROLE_IDS=

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Minimum 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_value_at_least_32_chars
SESSION_TTL_SECONDS=86400
# Set to true whenever the API is served over HTTPS.
COOKIE_SECURE=false
# Cookie domain. When the dashboard is on a different subdomain from this API
# (e.g. the site on flrp.us and this API on api.flrp.us), set the shared parent
# so the dashboard can read the CSRF cookie: .flrp.us — leave unset for local dev.
# COOKIE_DOMAIN=.flrp.us
# Comma separated list of allowed browser origins for the dashboard. In
# production this is the website's origin(s), e.g. https://flrp.us,https://www.flrp.us
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Where the OAuth callback returns the browser after a successful sign-in. The
# dashboard lives on the website, so in production this is the site origin, e.g.
# https://www.flrp.us — the callback appends /management/bot. Falls back to the
# first CORS_ALLOWED_ORIGINS entry when unset.
DASHBOARD_URL=http://localhost:3000

# --- Soft whitelist ----------------------------------------------------------
# The website posts whitelist submissions to this API, authenticated by a shared
# secret, and the API posts each to a staff review channel with Approve/Deny
# buttons; approving assigns the whitelist role. All three are optional — the
# feature stays inert until every one is set. Generate the token with:
#   openssl rand -hex 32
# The SAME token must be set as WHITELIST_INGEST_TOKEN on the website server.
WHITELIST_INGEST_TOKEN=
# The Discord channel id where submissions are posted for staff to review.
WHITELIST_REVIEW_CHANNEL_ID=
# The Discord role id (in the main community guild) granted on approval.
WHITELIST_ROLE_ID=

# --- Website (disciplinary records) ------------------------------------------
# The community website owns disciplinary records; the /bgcheck command reads a
# member's folded record from it and posts the embed the site builds. Both
# optional — /bgcheck reports it is unavailable until they are set.
#   WEBSITE_API_URL    the site origin, e.g. https://www.flrp.us
#   WEBSITE_BOT_TOKEN  the SAME shared secret the website validates as BOT_TOKEN
WEBSITE_API_URL=
WEBSITE_BOT_TOKEN=

# --- Sonoran CMS / CAD -------------------------------------------------------
# When a pair is set, a permanent /globalban also bans the member's Sonoran
# account in that product, and /globalunban lifts the CAD ban (Sonoran's API has
# no CMS unban - that one is reported as a manual step). Each product is inert
# until both of its values are set. Credentials come from each panel's API
# integration settings. CAD requires the Plus tier or higher for its API.
SONORAN_CMS_COMMUNITY_ID=
SONORAN_CMS_API_KEY=
SONORAN_CAD_COMMUNITY_ID=
SONORAN_CAD_API_KEY=

# Set to true only when running behind a trusted reverse proxy.
API_TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Synchronization tuning ---------------------------------------------------
# Lifetime of a Redis loop-protection marker. Must exceed the worst-case delay
# between applying a role change and receiving the resulting Discord event.
SYNC_MARKER_TTL_SECONDS=60

# A job that wants to remove more roles than this pauses and raises an issue
# instead of executing. Protects against accidental community-wide wipes.
SYNC_MAX_REMOVALS_THRESHOLD=50

# Per-member lock lifetime while a sync job applies changes.
SYNC_LOCK_TTL_SECONDS=30

# BullMQ worker concurrency per queue.
WORKER_CONCURRENCY=5

# Scheduled reconciliation of every member of every approved guild (cron, UTC).
RECONCILE_CRON=0 */6 * * *

# Daily mapping/role validation sweep (cron, UTC).
MAPPING_VALIDATION_CRON=0 3 * * *

# Automatic roster reconciliation for every roster (cron, UTC). Keeps the dashboards in
# step with Discord without pressing "Sync now"; each pass also breaks up any duplicate
# callsigns.
ROSTER_SWEEP_CRON=*/10 * * * *
