# =============================================================================
# Florida Roleplay Manager - example environment file
#
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# Every variable below is validated at startup by `@frm/shared/env`.
# In production, missing or weak required secrets abort the process (fail closed).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# development | production | test
NODE_ENV=development

# Development mode relaxes guild auto-leave, enables dry-run by default and
# allows the Discord gateway to be mocked. It is FORCED OFF when NODE_ENV=production.
DEV_MODE=true

# Comma separated guild IDs the bot is allowed to operate in while DEV_MODE=true.
DEV_GUILD_IDS=

# When true, no real Discord role writes are performed (development only).
DISCORD_MOCK=false

# When true, sync jobs default to dry-run unless explicitly told otherwise.
SYNC_DRY_RUN_DEFAULT=true

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://frm:frm_local_password@localhost:5432/frm?schema=public

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Discord application -----------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
# This value must never reach the frontend or any log line.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Only required by the API for the OAuth login flow.
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/discord/callback

# Comma separated Discord user IDs bootstrapped as global system administrators.
# These accounts are seeded with `system.manage` at GLOBAL scope.
GLOBAL_ADMIN_DISCORD_IDS=

# Optional webhook used to alert global administrators (unapproved guild joins,
# paused jobs, threshold breaches). Treated as a secret and redacted from logs.
ADMIN_ALERT_WEBHOOK_URL=

# --- API ---------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
# Minimum 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_value_at_least_32_chars
SESSION_TTL_SECONDS=86400
# Set to true whenever the API is served over HTTPS.
COOKIE_SECURE=false
# Comma separated list of allowed browser origins for the future dashboard.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Set to true only when running behind a trusted reverse proxy.
API_TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# --- Synchronization tuning ---------------------------------------------------
# Lifetime of a Redis loop-protection marker. Must exceed the worst-case delay
# between applying a role change and receiving the resulting Discord event.
SYNC_MARKER_TTL_SECONDS=60

# A job that wants to remove more roles than this pauses and raises an issue
# instead of executing. Protects against accidental community-wide wipes.
SYNC_MAX_REMOVALS_THRESHOLD=50

# Per-member lock lifetime while a sync job applies changes.
SYNC_LOCK_TTL_SECONDS=30

# BullMQ worker concurrency per queue.
WORKER_CONCURRENCY=5

# Scheduled reconciliation of every member of every approved guild (cron, UTC).
RECONCILE_CRON=0 */6 * * *

# Daily mapping/role validation sweep (cron, UTC).
MAPPING_VALIDATION_CRON=0 3 * * *
